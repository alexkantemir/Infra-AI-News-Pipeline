# ProxyAPI (https://proxyapi.ru) — text and image generation
PROXY_API_KEY=your_proxyapi_key_here
PROXY_TEXT_MODEL=claude-sonnet-4-6
PROXY_IMAGE_MODEL=gpt-image-1-mini

# VK — community access token + group ID
VK_ACCESS_TOKEN=your_vk_community_token_here
VK_GROUP_ID=your_vk_group_id_here

# Telegram — bot token + channel username or chat ID
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=@your_channel_username
